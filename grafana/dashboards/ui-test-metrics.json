          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.started_at AS \"Time\", r.browser AS \"Browser\", t.name AS \"Test\", t.status AS \"Status\",\n       t.duration_seconds AS \"Duration\", RIGHT(t.error_message, 300) AS \"Error\"\nFROM test_results t JOIN test_runs r ON r.id = t.run_id\nWHERE $__timeFilter(r.started_at) AND r.browser IN (${browser:sqlstring}) AND r.source IN (${source:sqlstring}) AND t.status IN ('failed', 'error')\nORDER BY t.started_at DESC LIMIT 50"
