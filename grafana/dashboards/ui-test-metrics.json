    {
      "id": 11,
      "type": "table",
      "title": "Per-test statistics",
      "description": "Pass rate excludes skipped executions.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "test-metrics-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "test-metrics-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.name AS \"Test\",\n       COUNT(*) AS \"Executions\",\n       ROUND(100.0 * COUNT(*) FILTER (WHERE t.status = 'passed')\n             / NULLIF(COUNT(*) FILTER (WHERE t.status <> 'skipped'), 0), 1) AS \"Pass rate\",\n       COUNT(*) FILTER (WHERE t.status IN ('failed', 'error')) AS \"Failures\",\n       AVG(t.duration_seconds) FILTER (WHERE t.status <> 'skipped') AS \"Avg duration\",\n       PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY t.duration_seconds)\n           FILTER (WHERE t.status <> 'skipped') AS \"p95 duration\",\n       MAX(t.duration_seconds) AS \"Max duration\"\nFROM test_results t JOIN test_runs r ON r.id = t.run_id\nWHERE $__timeFilter(r.started_at) AND r.browser IN (${browser:sqlstring}) AND r.source IN (${source:sqlstring})\nGROUP BY t.name ORDER BY t.name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pass rate"
