          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT finished_at AS time, browser AS metric,\n       ROUND(100.0 * passed / NULLIF(passed + failed + errors, 0), 1) AS value\nFROM test_runs WHERE $__timeFilter(started_at) AND browser IN (${browser:sqlstring}) AND source IN (${source:sqlstring})\nORDER BY 1"
