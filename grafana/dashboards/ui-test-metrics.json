    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Outcomes per test",
      "description": "How often each step passed, failed, errored or was skipped after an earlier failure.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "test-metrics-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "test-metrics-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT regexp_replace(t.name, '^test_', '') AS \"Test\",\n       COUNT(*) FILTER (WHERE t.status = 'passed')  AS \"passed\",\n       COUNT(*) FILTER (WHERE t.status = 'failed')  AS \"failed\",\n       COUNT(*) FILTER (WHERE t.status = 'error')   AS \"error\",\n       COUNT(*) FILTER (WHERE t.status = 'skipped') AS \"skipped\"\nFROM test_results t JOIN test_runs r ON r.id = t.run_id\nWHERE $__timeFilter(r.started_at) AND r.browser IN (${browser:sqlstring}) AND r.source IN (${source:sqlstring})\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
