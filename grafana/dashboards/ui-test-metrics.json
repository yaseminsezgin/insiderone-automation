    {
      "id": 12,
      "type": "table",
      "title": "Recent runs",
      "description": "Latest pytest sessions; the CI run column links to GitHub Actions.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "test-metrics-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "test-metrics-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Started\", browser AS \"Browser\", source AS \"Source\", branch AS \"Branch\",\n       LEFT(commit_sha, 7) AS \"Commit\", status AS \"Status\",\n       passed AS \"Passed\", failed + errors AS \"Failed\", skipped AS \"Skipped\",\n       duration_seconds AS \"Duration\", ci_run_url AS \"CI run\"\nFROM test_runs WHERE $__timeFilter(started_at) AND browser IN (${browser:sqlstring}) AND source IN (${source:sqlstring})\nORDER BY started_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "passed": {
                        "text": "✔ passed",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "failed": {
                        "text": "✖ failed",
                        "color": "#d03b3b",
                        "index": 1
                      },
                      "error": {
                        "text": "✖ error",
                        "color": "#ec835a",
                        "index": 2
                      },
                      "skipped": {
                        "text": "↷ skipped",
                        "color": "#fab219",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
