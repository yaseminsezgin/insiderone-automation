    {
      "id": 9,
      "type": "barchart",
      "title": "Average duration per test",
      "description": "Mean execution time of each step (setup + call + teardown), skipped steps excluded.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "test-metrics-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "test-metrics-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT regexp_replace(t.name, '^test_', '') AS \"Test\",\n       AVG(t.duration_seconds) FILTER (WHERE r.browser = 'chrome') AS \"chrome\",\n       AVG(t.duration_seconds) FILTER (WHERE r.browser = 'firefox') AS \"firefox\"\nFROM test_results t JOIN test_runs r ON r.id = t.run_id\nWHERE $__timeFilter(r.started_at) AND r.browser IN (${browser:sqlstring}) AND r.source IN (${source:sqlstring}) AND t.status <> 'skipped'\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
