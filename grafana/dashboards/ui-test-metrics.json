  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pass rate",
      "description": "Passed / (passed + failed + error). Skipped steps are excluded.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "test-metrics-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "test-metrics-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * SUM(passed) / NULLIF(SUM(passed + failed + errors), 0) AS \"Pass rate\"\nFROM test_runs WHERE $__timeFilter(started_at) AND browser IN (${browser:sqlstring}) AND source IN (${source:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
